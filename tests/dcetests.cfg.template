[global]

[TCPTransport]
# NetBIOS Name
servername =
# Targets IP
machine =
username =
password =
# NTLM Hash, you can grab it with secretsdump
hashes =
# Kerberos AES 256 Key, you can grab it with secretsdump
aesKey256 =
# Kerberos AES 128 Key, you can grab it with secretsdump
aesKey128 =
# It must be the domain FQDN
domain =
# This need to be a domain joined machine NetBIOS name
machineuser =
# Domain joined machine NetBIOS name hashes (grab them with secretsdump)
machineuserhashes =

[PAR]
# Opt in to adding/removing a uniquely named printer driver.
# Target and administrator credentials come from [TCPTransport] above.
driver_lifecycle = no
# Preconfigured version-3 driver files on the target (absolute Windows paths).
environment = Windows x64
driver_path =
data_file =
config_file =
